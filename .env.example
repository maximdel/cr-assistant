# Your Clash Royale API key, from https://developer.clashroyale.com
# Keys only work from the IP addresses you list when creating them.
CR_API_TOKEN=

# Optional: if your IP changes often, create a key for 45.79.218.79 instead
# and route requests through the RoyaleAPI proxy:
# CR_API_BASE_URL=https://proxy.royaleapi.dev/v1

# Optional: where the SQLite database lives (default: file:./prisma/dev.db)
# DATABASE_URL=file:./prisma/dev.db

# --- Only when hosting on an always-on server (see docs/DEPLOY.md) ---
# Save this player's matches every 2 minutes on the server, no open browser needed
# SYNC_TAG=#YOURTAG
# The address you open the app at; used for the deck picture in phone notifications
# PUBLIC_URL=https://<machine>.<tailnet>.ts.net:8443
# Push alerts for failed updates/backups through ntfy (https://ntfy.sh)
# NTFY_URL=https://ntfy.sh/cr-assistant-<random>
